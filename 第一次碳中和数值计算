    "# 计算一家小型企业某月的碳排放（Scope 2：外购电力）\n",
    "# 这是你的第一个\"碳中和+Python\"代码\n",
    "\n",
    "# 1. 定义变量\n",
    "monthly_electricity_kwh = 50000  # 月用电量：50000度\n",
    "grid_emission_factor = 0.5703    # 电网排放因子（吨CO2/万度），中国2024年默认值\n",
    "\n",
    "# 2. 计算碳排放量\n",
    "co2_emission = monthly_electricity_kwh * grid_emission_factor / 10000\n",
    "\n",
    "# 3. 输出结果\n",
    "print(f\"该企业本月因外购电力产生的碳排放为：{co2_emission:.2f} 吨CO2\")\n",
    "print(\"=\" * 40)\n",
    "print(\"碳核算完成！\")"
   ]
