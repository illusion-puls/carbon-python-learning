   "source": [
    "# 作业：用 f-string 生成一段文字，包含：企业名、三种燃料（电、天然气、柴油）的用量和各自碳排放，要求保留2位小数。\n",
    "# 定义变量\n",
    "company = \"蓝天制造有限公司\"\n",
    "electricity_usage = 1.25e6                      # 用电量，单位：千瓦时\n",
    "electricity_emission = 712.88                  # 电-碳排放，单位：吨\n",
    "gas_usage = 8.5e4                       # 天然气用量，单位：立方米\n",
    "gas_emission = 183.77                  # 天然气-碳排放，单位：吨\n",
    "diesel_usage = 3.2e4                     # 柴油用量，单位：升\n",
    "diesel_emission = 85.76                   # 柴油-碳排放，单位：吨\n",
    "\n",
    "# 使用f-string 格式化输出，其原理为：在字符串前加 f，变量用 {} 包裹，其中{变量:格式说明符}\n",
    "report = f\"\"\"\n",
    "【{company}】碳排放核算报告\n",
    "{'='*70}\n",
    "用电量:{electricity_usage:<15,.2f} 千瓦时    对应CO2的排放量：{electricity_emission:>15,.2f} 吨\n",
    "天然气用量:{gas_usage:<15,.2f} 立方米        对应CO2的排放量：{gas_emission:>15,.2f} 吨\n",
    "柴油用量:{diesel_usage:<15,.2f} 升             对应CO2的排放量：{diesel_emission:>15,.2f} 吨\n",
    "碳排放总量：{electricity_emission + gas_emission + diesel_emission:.2f} 吨\n",
    "{'='*70}\n",
    "\"\"\"\n",
    "\n",
    "print(report)\n",
    "\n",
    "\n",
    "# 记录一下编写代码中出现的问题：\n",
    "# 1、在 JupyterLab 里，批量给变量改名----安装 jupyterlab-lsp 扩展\n",
    "# 2、规范编写代码的格式：“#”之后应该空一格，不然会有黄色波浪线警告可能会出问题\n",
    "# 3、再给变量命名时不能出现“-”，会被识别为减号\n",
    "# 4、把多个字符串/变量组合成一个 使用f-string 格式化输出，\n",
    "#    其原理为：在字符串前加 f，变量用 {} 包裹，其中{变量: [填充+对齐] [符号] [宽度] [千分位] [.精度] [类型]}\n",
    "#    对齐宽度在前，千分位在中，精度类型在后。\n"
   ]
