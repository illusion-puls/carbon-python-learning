   "source": [
    "#范例\n",
    "# ===== 数据定义 =====\n",
    "company = \"蓝天制造有限公司\"\n",
    "\n",
    "# 三种燃料用量\n",
    "electricity_usage = 1250000.00    # 电：千瓦时\n",
    "gas_usage = 85000.00              # 天然气：立方米\n",
    "diesel_usage = 32000.00           # 柴油：升\n",
    "\n",
    "# 各自碳排放（吨CO2）\n",
    "electricity_emission = 712.88\n",
    "gas_emission = 183.77\n",
    "diesel_emission = 85.76\n",
    "total_emission = 982.40\n",
    "\n",
    "# ===== 用 f-string 生成报告（作业核心）=====\n",
    "report = f\"\"\"\n",
    "{'='*40}\n",
    "{company} 燃料碳排放核算报告\n",
    "{'='*40}\n",
    "燃料类型      用量              碳排放(吨CO2)\n",
    "{'-'*40}\n",
    "电            {electricity_usage:>12.2f} 千瓦时    {electricity_emission:>10.2f}\n",
    "天然气        {gas_usage:>12.2f} 立方米    {gas_emission:>10.2f}\n",
    "柴油          {diesel_usage:>12.2f} 升      {diesel_emission:>10.2f}\n",
    "{'-'*40}\n",
    "总排放                                      {total_emission:>10.2f}\n",
    "{'='*40}\n",
    "\"\"\"\n",
    "\n",
    "print(report)\n",
    "\n",
    "# ===== 字符串方法练习（呼应课程）=====\n",
    "print(\"\\n【字符串方法演示】\")\n",
    "print(f\"企业名称大写：{company.upper()}\")\n",
    "print(f\"替换演示：{report.replace('CO2', '二氧化碳')[:60]}...\")"
   ]
